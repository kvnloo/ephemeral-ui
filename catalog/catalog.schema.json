{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/ephemeral-ui/catalog/catalog.schema.json",
  "title": "ephemeral-ui card catalog (v0)",
  "description": "Every card kind the kit defines, with fixtures an app's gallery renders. Generated by tools/card-catalog.mjs; see catalog/README.md.",
  "type": "object",
  "required": ["v", "version", "generatedAt", "renderer", "count", "kinds"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "v": { "const": 0, "description": "Shape of this file. A breaking change to the shape bumps it." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "catalog/VERSION. Minor: a kind added or props changed. Major: a kind removed or renamed." },
    "generatedAt": { "type": "string", "format": "date-time", "description": "The frozen clock the fixtures were rendered at, not the wall time (keeps the file reproducible)." },
    "renderer": {
      "type": "object",
      "description": "The reference renderer the props came from.",
      "required": ["modules", "call", "apps", "themes", "cardSchema"],
      "additionalProperties": false,
      "properties": { "modules": { "type": "string" }, "call": { "type": "string" }, "apps": { "type": "string" }, "themes": { "type": "string" }, "cardSchema": { "type": "string" } }
    },
    "count": {
      "type": "object",
      "required": ["kinds", "fixtures"],
      "additionalProperties": false,
      "properties": { "kinds": { "type": "integer", "minimum": 1 }, "fixtures": { "type": "integer", "minimum": 1 } }
    },
    "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kind" } }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "required": ["kind", "label", "group", "module", "export", "site", "programmable", "input", "data", "apps", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "group": { "enum": ["app", "studio", "trace", "intent", "intel", "ops", "fleet", "agent"], "description": "Gallery section." },
        "module": { "type": "string", "pattern": "^src/js/kinds-[\\w-]+\\.js$" },
        "export": { "type": "string", "pattern": "^KINDS_[A-Z0-9_]+$" },
        "site": { "type": "boolean", "description": "Shown on the site's gallery (src/js/main.js KINDS)." },
        "programmable": { "type": "boolean", "description": "Listed in src/schema/card.v0.json properties.kind.enum, so a model may emit it in an ephemeral-ui fence." },
        "input": { "enum": ["none", "appInput", "data"], "description": "none: draws sample data. appInput: card.input per card.v0 $defs.appInput. data: renders only a validated data document (fleet.v0, intel.v0)." },
        "data": { "type": "array", "items": { "type": "string" }, "description": "Fixture files the reference renderer reads besides apps.json and themes.json." },
        "apps": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "type": "object", "required": ["id", "name", "inCatalog"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "inCatalog": { "type": "boolean", "description": "In src/data/apps.json; false means a host app (k3s, glide, z0) the gallery draws with a neutral monogram." } } }
        },
        "fixtures": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/fixture" } }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "state", "seed", "card", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z0-9-]+(/[a-z]+)?$", "description": "Stable gallery cell id: <kind>/<app>[/<state>]." },
        "state": { "enum": ["sample", "input", "example", "unavailable"] },
        "seed": { "type": "string", "description": "rng seed for sample data: app id + kind, as the site seeds it." },
        "card": {
          "type": "object", "description": "The card.v0 document to render.",
          "required": ["kind", "app"],
          "properties": { "kind": { "type": "string" }, "app": { "type": "string" }, "input": {} }
        },
        "props": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } }, "description": "The reference renderer's spec for this card, keys sorted. A native renderer takes these as its props." }
      }
    }
  }
}
